<div class="options">
  <div class="options__left">

    <div id="stopVideo" class="options__button" title="Камера">
      <i class="fa fa-video-camera"></i>
    </div>

    <div id="screenShareButton" class="options__button" title="Экран">
      <i class="fa fa-desktop"></i>
    </div>

    <div id="muteButton" class="options__button" title="Микрофон">
      <i class="fa fa-microphone"></i>
    </div>

    <div id="fullscreenButton" class="options__button" title="Развернуть на весь экран">
      <i class="fas fa-expand"></i>
    </div>

  </div>

  <div class="options__right">

    <div id="inviteButton" class="options__button" title="Пригласить">
      <i class="fa fa-user-plus"></i>
    </div>

    <div id="showChat" class="options__button" title="Чат">
      <i class="fa fa-comment-slash"></i>
    </div>
    
  </div>
</div>